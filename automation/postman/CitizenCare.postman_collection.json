{
  "info": {
    "_postman_id": "c17171e2-9f3a-4a27-9c92-citizencare2026",
    "name": "CitizenCare REST API Automated Collection",
    "description": "Enterprise Postman collection for CitizenCare with pre-request scripts, JWT token capture, and response assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Citizen\",\n  \"email\": \"postman.citizen@citizencare.gov\",\n  \"password\": \"Citizen@123\",\n  \"phone\": \"+1 555-4422\",\n  \"role\": \"CITIZEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 409 Conflict', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@citizencare.gov\",\n  \"password\": \"Citizen@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.environment.set('citizenToken', jsonData.data.token);",
                  "    pm.environment.set('citizenId', jsonData.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff.roads@citizencare.gov\",\n  \"password\": \"Staff@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.environment.set('staffToken', jsonData.data.token);",
                  "    pm.environment.set('staffId', jsonData.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.categories.length > 0) {",
                  "    pm.environment.set('categoryId', jsonData.data.categories[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Complaint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{citizenToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Automated Road Crater Inspection\",\n  \"description\": \"Large pothole observed in front of building 500 during automated collection execution.\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"location\": \"500 Fifth Avenue, Midtown\",\n  \"priority\": \"HIGH\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints", "host": ["{{baseUrl}}"], "path": ["complaints"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.complaint) {",
                  "    pm.environment.set('complaintId', jsonData.data.complaint.id);",
                  "    pm.environment.set('complaintNumber', jsonData.data.complaint.complaintNumber);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Complaint Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintId}}", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintId}}"] }
          }
        },
        {
          "name": "Staff Update Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"remarks\": \"Field crew dispatched with asphalt mixer.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/complaints/{{complaintId}}/status", "host": ["{{baseUrl}}"], "path": ["complaints", "{{complaintId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "Admin & Analytics",
      "item": [
        {
          "name": "Get System Analytics KPIs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/analytics", "host": ["{{baseUrl}}"], "path": ["admin", "analytics"] }
          }
        }
      ]
    }
  ]
}
